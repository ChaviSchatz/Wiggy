# Supabase (public browser client). Copy to `.env.local` and fill in values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service-role key. Required by `npm run seed:dev`, `npm run test:integration`,
# and — since the platform admin console shipped — by the deployed app itself at runtime
# (src/lib/platform-admin/{actions,queries}.ts). Must be set in Vercel's production
# environment, not just local `.env.local`, or /platform crashes with a missing-env-var error.
# NEVER expose this to the browser or commit a real value. (Local dev value comes from `supabase start`.)
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed into the platform-admin console
# (/platform), which can create new businesses and invite their first admin.
# Server-only — NEVER expose this to the browser or commit real addresses.
# Empty/unset means no one can access the console.
PLATFORM_ADMIN_EMAILS=
